AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://steward-tree-api
AUTH0_SPA_CLIENT_ID=your-spa-client-id
AUTH0_DATABASE_CONNECTION=Username-Password-Authentication
AUTH0_MGMT_CLIENT_ID=your-management-api-client-id
AUTH0_MGMT_CLIENT_SECRET=your-management-api-client-secret
ENABLE_TEST_LOGIN=false
# Local development uses the Docker Compose defaults. For a hosted database,
# set NETLIFY_DB_URL or DATABASE_URL in the host's secret environment settings.

AWS_REGION=us-east-2
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key